# ===========================================================================
# Project Recallix — Environment Configuration Template
# Copy this file to .env and adjust variables as needed.
# ===========================================================================

# --- Database ---
RECALLIX_DATABASE_URL=sqlite:///data/recallix.db
RECALLIX_DB_PATH=data/recallix.db

# --- Embedding Model ---
RECALLIX_EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Local LLM (Ollama) ---
RECALLIX_LLM_MODEL=qwen2.5:3b
RECALLIX_OLLAMA_MODEL=qwen2.5:3b
RECALLIX_LLM_BASE_URL=http://localhost:11434
RECALLIX_LLM_TIMEOUT=120
RECALLIX_LLM_CONNECT_TIMEOUT=3

# --- Retrieval Configuration ---
RECALLIX_TOP_K=5
RECALLIX_MIN_RELEVANCE=0.25

# --- Observability & Metrics ---
RECALLIX_LOG_LEVEL=INFO
RECALLIX_ENABLE_METRICS=true

# --- Safety & Sanitization Limits ---
RECALLIX_MAX_MEMORY_LENGTH=500
RECALLIX_MAX_QUERY_LENGTH=1000
